{
  "manifest_version": 3,
  "name": "Uber Eats Habits",
  "version": "0.1.13",
  "description": "Retrouvez votre historique de commandes Uber Eats.",
  "content_scripts": [
    {
      "matches": ["https://www.ubereats.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/orders.js",
        "src/ratings.js",
        "src/ui.js",
        "src/panel.css",
        "src/api-client.js",
        "src/api-interceptor.js",
        "src/api.services.js"
      ],
      "matches": ["https://www.ubereats.com/*"]
    }
  ]
}
